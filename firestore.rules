rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Core Authorization Helpers ---

    function isAuthenticated() {
      return request.auth != null;
    }

    function isEmployee() {
      return isAuthenticated() &&
             request.auth.token.email != null &&
             request.auth.token.email.matches('.*\\.gov\\.in$');
    }

    function actorPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function actorData() {
      return get(actorPath()).data;
    }

    function actorExists() {
      return isAuthenticated() && exists(actorPath());
    }

    function isSuperAdmin() { return actorExists() && actorData().role == 'super_admin'; }
    function isReadOnlyAdmin() { return actorExists() && actorData().role == 'readonly_super_admin'; }
    function isTalukAdmin() { return actorExists() && actorData().role == 'taluk_admin'; }
    function isSuperLevel() { return isSuperAdmin() || isReadOnlyAdmin(); }

    // --- Master Data (Viewable by all auth users, writable only by primary Super Admin) ---

    match /roles/{id} { allow read: if isAuthenticated(); allow write: if isSuperAdmin(); }
    match /permissions/{id} { allow read: if isAuthenticated(); allow write: if isSuperAdmin(); }
    match /taluks/{id} { allow read: if isAuthenticated(); allow write: if isSuperAdmin(); }
    match /departments/{id} { allow read: if isAuthenticated(); allow write: if isSuperAdmin(); }
    match /complaintCategories/{id} { allow read: if isAuthenticated(); allow write: if isSuperAdmin(); }
    match /complaintStatuses/{id} { allow read: if isAuthenticated(); allow write: if isSuperAdmin(); }
    match /metadata/{id} { allow read: if isAuthenticated(); allow write: if isSuperAdmin(); }
    match /settings/{id} { allow read: if isAuthenticated(); allow write: if isSuperAdmin(); }

    // --- Functional Collections ---

    // 1. Users
    match /users/{uid} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // 2. Complaints / Service Requests
    match /complaints/{id} {
      allow create: if isAuthenticated();

      allow list: if isSuperLevel() ||
                  (isTalukAdmin() && resource.data.taluk == actorData().taluk) ||
                  (resource.data.assignedStaffId == request.auth.uid) ||
                  (isAuthenticated() && resource.data.citizenId == request.auth.uid);

      allow get: if isAuthenticated() && (
        isSuperLevel() ||
        (isTalukAdmin() && resource.data.taluk == actorData().taluk) ||
        (resource.data.assignedStaffId == request.auth.uid) ||
        (resource.data.citizenId == request.auth.uid)
      );

      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (isTalukAdmin() && resource.data.taluk == actorData().taluk) ||
        (resource.data.assignedStaffId == request.auth.uid && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['citizenId', 'taluk', 'departmentId'])
        )) ||
        (resource.data.citizenId == request.auth.uid && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments', 'history', 'timeline', 'status', 'updatedAt', 'photos', 'attachments', 'remarks', 'assignedStaffId', 'assignedStaffName', 'assignmentHistory'])
        ))
      );

      allow delete: if isSuperAdmin();
    }

    // 3. Notifications
    match /notifications/{id} {
      allow list, get: if isSuperLevel() || (isAuthenticated() && resource.data.recipientUid == request.auth.uid);
      allow create: if isAuthenticated();
      allow update: if isSuperAdmin() || (isAuthenticated() && resource.data.recipientUid == request.auth.uid && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'archived', 'updatedAt'])
      ));
      allow delete: if isSuperAdmin() || (isAuthenticated() && resource.data.recipientUid == request.auth.uid);
    }

    // 4. Audit Logs
    match /auditLogs/{id} {
      allow read: if isSuperLevel() || isEmployee();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }
  }
}
