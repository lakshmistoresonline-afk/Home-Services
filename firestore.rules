rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---

    function isAuthenticated() {
      return request.auth != null;
    }

    function isUserDoc(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function userExists() {
      return isAuthenticated() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserRole() {
      return userExists() ? getUserData().role : 'citizen';
    }

    function isUserActive() {
      return userExists() && (getUserData().isActive == true || getUserData().status == 'active');
    }

    function isSuperAdmin() {
      return isAuthenticated() && (getUserRole() == 'super_admin' || request.auth.token.role == 'super_admin');
    }

    function isReadOnlyAdmin() {
      return isAuthenticated() && (getUserRole() == 'readonly_super_admin' || request.auth.token.role == 'readonly_super_admin');
    }

    function isTalukAdmin() {
      return isAuthenticated() && (getUserRole() == 'taluk_admin' || getUserRole() == 'ward_admin' || request.auth.token.role == 'taluk_admin');
    }

    function isStaff() {
      return isAuthenticated() && (getUserRole() == 'staff' || request.auth.token.role == 'staff');
    }

    function isCitizen() {
      return isAuthenticated() && getUserRole() == 'citizen';
    }

    // --- Master Data & Catalog (Public Read for Browsing, Writable by Super Admin) ---

    match /roles/{id} { allow read: if isAuthenticated(); allow write: if isSuperAdmin(); }
    match /permissions/{id} { allow read: if isAuthenticated(); allow write: if isSuperAdmin(); }
    match /taluks/{id} { allow read: if true; allow write: if isSuperAdmin(); }
    match /departments/{id} { allow read: if true; allow write: if isSuperAdmin(); }
    match /serviceCategories/{id} { allow read: if true; allow write: if isSuperAdmin(); }
    match /serviceStatuses/{id} { allow read: if true; allow write: if isSuperAdmin(); }
    match /servicePriorities/{id} { allow read: if true; allow write: if isSuperAdmin(); }
    match /dashboardConfigurations/{id} { allow read: if isAuthenticated(); allow write: if isSuperAdmin(); }
    match /reportConfigurations/{id} { allow read: if isAuthenticated(); allow write: if isSuperAdmin(); }
    match /notificationTemplates/{id} { allow read: if isAuthenticated(); allow write: if isSuperAdmin(); }
    match /metadata/{id} { allow read: if isAuthenticated(); allow write: if isSuperAdmin(); }
    match /settings/{id} { allow read: if isAuthenticated(); allow write: if isSuperAdmin(); }

    // --- Users Collection ---

    match /users/{uid} {
      allow create: if isAuthenticated();

      allow read: if isAuthenticated() && (
        isUserDoc(uid) ||
        isSuperAdmin() ||
        isReadOnlyAdmin() ||
        isTalukAdmin() ||
        isStaff()
      );

      allow update: if isAuthenticated() && (
        isSuperAdmin() ||
        (
          isUserDoc(uid) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'permissions', 'isActive', 'status'])
        )
      );

      allow delete: if isSuperAdmin();
    }

    // --- Service Requests Collection ---

    match /serviceRequests/{id} {
      allow create: if isAuthenticated() && isUserActive() && (
        isSuperAdmin() ||
        request.resource.data.citizenId == request.auth.uid
      );

      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        isReadOnlyAdmin() ||
        resource.data.citizenId == request.auth.uid ||
        resource.data.assignedStaffId == request.auth.uid ||
        (isTalukAdmin() && (
          !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
          getUserData().taluk == null ||
          getUserData().taluk == resource.data.taluk
        ))
      );

      allow update: if isAuthenticated() && isUserActive() && !isReadOnlyAdmin() && (
        isSuperAdmin() ||
        (resource.data.citizenId == request.auth.uid && request.resource.data.status in ['Cancelled', 'Reopened']) ||
        (resource.data.assignedStaffId == request.auth.uid && request.resource.data.status in ['Accepted', 'Rejected', 'In Progress', 'Resolved']) ||
        (isTalukAdmin() && (
          getUserData().taluk == null ||
          getUserData().taluk == resource.data.taluk
        ))
      );

      allow delete: if isSuperAdmin();
    }

    // Legacy complaints collection
    match /complaints/{id} {
      allow read, write: if isAuthenticated();
    }

    // --- Notifications & Activity ---

    match /notifications/{id} {
      allow read: if isAuthenticated() && (
        resource.data.recipientUid == request.auth.uid ||
        isSuperAdmin()
      );
      allow create, update: if isAuthenticated();
      allow delete: if isSuperAdmin() || (isAuthenticated() && resource.data.recipientUid == request.auth.uid);
    }

    match /comments/{id} {
      allow read, create: if isAuthenticated();
      allow update, delete: if isSuperAdmin() || (isAuthenticated() && resource.data.author_id == request.auth.uid);
    }

    match /timeline/{id} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isSuperAdmin();
    }

    match /attachments/{id} {
      allow read, create: if isAuthenticated();
      allow update, delete: if isSuperAdmin();
    }

    // --- Audit Logs ---

    match /auditLogs/{id} {
      allow read: if isAuthenticated() && (isSuperAdmin() || isReadOnlyAdmin());
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }
  }
}
