rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isAuthenticated() && getUserData().role == 'super_admin';
    }

    // --- Service Request Photos & Attachments ---
    // Paths: serviceRequests/{complaintId}/{filename} and complaints/{complaintId}/{filename}

    match /serviceRequests/{complaintId}/{filename} {
      allow read: if isAuthenticated() && (
        isSuperAdmin() ||
        complaintId.startsWith('TEMP_' + request.auth.uid + '_') ||
        (
          firestore.exists(/databases/(default)/documents/serviceRequests/$(complaintId)) &&
          (
            getUserData().taluk == firestore.get(/databases/(default)/documents/serviceRequests/$(complaintId)).data.taluk ||
            request.auth.uid == firestore.get(/databases/(default)/documents/serviceRequests/$(complaintId)).data.citizenId ||
            request.auth.uid == firestore.get(/databases/(default)/documents/serviceRequests/$(complaintId)).data.assignedStaffId
          )
        )
      );

      allow write: if isAuthenticated() && (
        isSuperAdmin() ||
        complaintId.startsWith('TEMP_' + request.auth.uid + '_') ||
        (
          firestore.exists(/databases/(default)/documents/serviceRequests/$(complaintId)) &&
          (
            request.auth.uid == firestore.get(/databases/(default)/documents/serviceRequests/$(complaintId)).data.citizenId ||
            request.auth.uid == firestore.get(/databases/(default)/documents/serviceRequests/$(complaintId)).data.assignedStaffId
          )
        )
      ) && request.resource.size < 5 * 1024 * 1024 // Max 5MB per file
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType.matches('application/pdf'));
    }

    match /complaints/{complaintId}/{filename} {
      allow read, write: if isAuthenticated() && request.resource.size < 5 * 1024 * 1024;
    }

    // --- Profile Photos ---
    match /profiles/{uid}/{filename} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == uid
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
