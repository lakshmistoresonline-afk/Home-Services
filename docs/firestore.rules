rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Core Authorization Helpers ---

    function isAuthenticated() {
      return request.auth != null;
    }

    function isEmployee() {
      return isAuthenticated() &&
             request.auth.token.email != null &&
             request.auth.token.email.matches('.*\\.gov\\.in$');
    }

    function actorPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function actorData() {
      return get(actorPath()).data;
    }

    function actorExists() {
      return isAuthenticated() && exists(actorPath());
    }

    function isSuperAdmin() { return actorExists() && actorData().role == 'super_admin'; }
    function isReadOnlyAdmin() { return actorExists() && actorData().role == 'readonly_super_admin'; }
    function isTalukAdmin() { return actorExists() && actorData().role == 'taluk_admin'; }
    function isSuperLevel() { return isSuperAdmin() || isReadOnlyAdmin(); }

    // --- Master Data (Viewable publicly for catalog browsing, writable only by Super Admin) ---

    match /roles/{id} { allow read: if true; allow write: if isSuperAdmin(); }
    match /permissions/{id} { allow read: if true; allow write: if isSuperAdmin(); }
    match /taluks/{id} { allow read: if true; allow write: if isSuperAdmin(); }
    match /departments/{id} { allow read: if true; allow write: if isSuperAdmin(); }
    match /complaintCategories/{id} { allow read: if true; allow write: if isSuperAdmin(); }
    match /serviceCategories/{id} { allow read: if true; allow write: if isSuperAdmin(); }
    match /complaintStatuses/{id} { allow read: if true; allow write: if isSuperAdmin(); }
    match /serviceStatuses/{id} { allow read: if true; allow write: if isSuperAdmin(); }
    match /servicePriorities/{id} { allow read: if true; allow write: if isSuperAdmin(); }
    match /metadata/{id} { allow read: if true; allow write: if isSuperAdmin(); }
    match /settings/{id} { allow read: if true; allow write: if isSuperAdmin(); }

    // --- Functional Collections ---

    // 1. Users
    match /users/{uid} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // 2. Service Requests
    match /serviceRequests/{id} {
      allow create, list, get, update: if isAuthenticated();
      allow delete: if isSuperAdmin();
    }

    // 3. Notifications
    match /notifications/{id} {
      allow read, write: if isAuthenticated();
    }

    // 4. Audit Logs
    match /auditLogs/{id} {
      allow read, create: if isAuthenticated();
      allow update, delete: if false;
    }
  }
}
